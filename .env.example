# Copy this file to .env and fill in real values.
# NEVER commit a .env file with real credentials.

# SQLite database (local file — fine for the MVP)
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------
# AI provider (optional, server-side only)
# ---------------------------------------------------------------
# Leave AI_API_KEY unset and Draftly runs its built-in generator. That path is
# fully functional and clearly labelled in the UI as NOT being an LLM — it
# follows your brand inputs but does not write like a model. Set a key to turn
# on real LLM generation, the live assistant, and translation.

# Which API shape to use: "openai" or "anthropic".
#   openai    -> any OpenAI-compatible /chat/completions endpoint
#                (OpenAI, Groq, Together, OpenRouter, DeepSeek, Ollama,
#                 Google Gemini, vLLM…)
#   anthropic -> Anthropic Messages API
# AI_PROVIDER="openai"

# Your key. This is read on the server only and is never sent to the browser.
# Create a Gemini key at https://aistudio.google.com/app/apikey — but never
# paste the key into this file: copy this file to .env first and set it there.
# AI_API_KEY=""

# Optional. Defaults to gpt-4o-mini (openai) or a Claude model (anthropic).
# AI_MODEL="gpt-4o-mini"

# Optional. Override for a compatible endpoint, e.g. a local server.
# AI_BASE_URL="https://api.openai.com/v1"

# ---------------------------------------------------------------
# Google Gemini via the OpenAI-compatible endpoint (no new dependency)
# ---------------------------------------------------------------
# Gemini exposes an OpenAI-compatible /chat/completions API, so the "openai"
# provider shape above works with three settings:
#
#   AI_PROVIDER="openai"
#   AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
#   AI_API_KEY="<your Gemini key from https://aistudio.google.com/app/apikey>"
#   AI_MODEL="gemini-3.8-flash"
#
# Keep AI_MODEL configurable: valid IDs are the ones listed on the Gemini
# models page (gemini-3.8-flash, gemini-3.5-flash-lite, gemini-3.1-pro-preview
# at the time of writing) — they rotate, so check
# https://ai.google.dev/gemini-api/docs/models before switching.